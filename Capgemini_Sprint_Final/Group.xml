            </run>
        </groups>

        <packages>
            <package name="ecom.swaglabs.login"/>
            <package name="ecom.swaglabs.product"/>
            <package name="ecom.swaglabs.cart"/>
            <package name="ecom.swaglabs.checkout"/>
            <package name="ecom.swaglabs.hamburger"/>
        </packages>
    </test>


    <test name="System Tests">
    <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="system"/>
            </run>
        </groups>

        <packages>
            <package name="ecom.swaglabs.login"/>
            <package name="ecom.swaglabs.product"/>
            <package name="ecom.swaglabs.cart"/>
            <package name="ecom.swaglabs.checkout"/>
            <package name="ecom.swaglabs.hamburger"/>
        </packages>
    </test>

    <test name="Negative Tests">
    <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="negative"/>
            </run>
        </groups>

        <packages>
            <package name="ecom.swaglabs.login"/>
            <package name="ecom.swaglabs.product"/>
            <package name="ecom.swaglabs.cart"/>
            <package name="ecom.swaglabs.checkout"/>
            <package name="ecom.swaglabs.hamburger"/>
        </packages>
    </test>

</suite>