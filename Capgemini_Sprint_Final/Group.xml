<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SauceDemo Group Execution Suite">


    <test name="Smoke Tests">
    <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>

        <packages>
            <package name="ecom.swaglabs.login"/>
            <package name="ecom.swaglabs.product"/>
            <package name="ecom.swaglabs.cart"/>
            <package name="ecom.swaglabs.checkout"/>
            <package name="ecom.swaglabs.hamburger"/>
        </packages>
    </test>

    <test name="Functional Tests">
    <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="functional"/>
            </run>
        </groups>

        <packages>
            <package name="ecom.swaglabs.login"/>
            <package name="ecom.swaglabs.product"/>
            <package name="ecom.swaglabs.cart"/>
            <package name="ecom.swaglabs.checkout"/>
            <package name="ecom.swaglabs.hamburger"/>
        </packages>
    </test>

    <test name="Integration Tests">
    <parameter name="browser" value="chrome"/>
        <groups>
            <run>
