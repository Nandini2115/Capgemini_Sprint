<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SauceDemo Cross Browser Suite">

    <!-- CHROME -->
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="ecom.swaglabs.login.Login_Test_Script1"/>
            <class name="ecom.swaglabs.login.Login_Test_Script2"/>

            <class name="ecom.swaglabs.product.Product_Test_Script1"/>
            <class name="ecom.swaglabs.product.Product_Test_Script2"/>

            <class name="ecom.swaglabs.cart.Cart_Test_Script1"/>
            <class name="ecom.swaglabs.cart.Cart_Test_Script2"/>
            <class name="ecom.swaglabs.cart.Cart_Test_Script3"/>

            <class name="ecom.swaglabs.checkout.CheckOut_Test_Script1"/>
            <class name="ecom.swaglabs.checkout.CheckOut_Test_Script2"/>

            <class name="ecom.swaglabs.hamburger.HamBurger_Test_Script1"/>
        </classes>
    </test>

    <!-- EDGE -->
    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="com.swaglabs.login.Login_Test_Script1"/>
            <class name="com.swaglabs.login.Login_Test_Script2"/>

            <class name="com.swaglabs.product.Product_Test_Script1"/>
            <class name="com.swaglabs.product.Product_Test_Script2"/>

            <class name="com.swaglabs.cart.Cart_Test_Script1"/>
            <class name="com.swaglabs.cart.Cart_Test_Script2"/>
            <class name="com.swaglabs.cart.Cart_Test_Script3"/>

            <class name="com.swaglabs.checkout.CheckOut_Test_Script1"/>
            <class name="com.swaglabs.checkout.CheckOut_Test_Script2"/>

            <class name="com.swaglabs.hamburger.HamBurger_Test_Script1"/>
        </classes>
    </test>

    <!-- FIREFOX -->
    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="com.swaglabs.login.Login_Test_Script1"/>
            <class name="com.swaglabs.login.Login_Test_Script2"/>

            <class name="com.swaglabs.product.Product_Test_Script1"/>
            <class name="com.swaglabs.product.Product_Test_Script2"/>

            <class name="com.swaglabs.cart.Cart_Test_Script1"/>
            <class name="com.swaglabs.cart.Cart_Test_Script2"/>
            <class name="com.swaglabs.cart.Cart_Test_Script3"/>

            <class name="com.swaglabs.checkout.CheckOut_Test_Script1"/>
            <class name="com.swaglabs.checkout.CheckOut_Test_Script2"/>

            <class name="com.swaglabs.hamburger.HamBurger_Test_Script1"/>
        </classes>
    </test>

</suite>
